# Paso 1. Limpiar el estado de preparación

```bash
$ErrorActionPreference = "Stop"

$cg = Get-ClusterGroup -Name "Azure Stack HCI Update Service Cluster Group"

Write-Host "Stopping update service cluster group"
$cg | Stop-ClusterGroup

Write-Host "Getting name of preparation dictionary property"

$prepDict = Get-Item HKLM:\Cluster\ACS\RDictionary\UpdateWinService\UpdateWinService\PreparationDictionary

$propName = $prepDict.Property

if (-not $propName)
{
    Write-Host "Unable to find the expected property"
    return
}

$nodes = Get-ClusterNode | % Name

Write-Host "Removing property $propName from all nodes: $($nodes -join ',')"

Invoke-Command $nodes {
    Remove-ItemProperty `
    -Path HKLM:\Cluster\ACS\RDictionary\UpdateWinService\UpdateWinService\PreparationDictionary `
    -Name $using:propName
}

Write-Host "Starting update service cluster group"

$cg | Start-ClusterGroup
```
